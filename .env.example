AGENT_DATABASE_URL=sqlite:///./data/agent.db

# LLM provider — this project uses Google Gemini.
AGENT_LLM_PROVIDER=gemini

# Gemini model (verified available on the provided key):
#   gemini-2.5-pro   — main reasoning nodes (plan / write-code / reflect / answer)
#   gemini-2.5-flash — light nodes (follow-up suggestions, Phase 2)
AGENT_LLM_MODEL=gemini-2.5-pro

# Set the Gemini API key (newer AQ.-prefix format). Anthropic is unused.
AGENT_ANTHROPIC_API_KEY=
AGENT_GEMINI_API_KEY=

PORT=8001
